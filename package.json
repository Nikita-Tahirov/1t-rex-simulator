{
  "name": "1trex-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "description": "Веб-симулятор боевого робота 1T-REX — ВКР по программированию интеллектуальных роботов",
  "license": "MIT",
  "author": "Nikita Takhirov <nikita.tahirov@gmail.com>",
  "homepage": "https://rex-1t.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikita-Tahirov/1t-rex-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/Nikita-Tahirov/1t-rex-simulator/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc -b --noEmit",
    "line:check": "node scripts/check-line-budget.mjs",
    "source:check": "node scripts/check-source-hygiene.mjs",
    "firebase:check": "node scripts/check-firebase-ci.mjs",
    "hosting:smoke": "node scripts/check-hosting-render.mjs",
    "budgets:check": "node scripts/check-performance-budget.mjs",
    "net:sweep": "node scripts/net-sweep.mjs",
    "clean": "node scripts/clean.mjs",
    "format": "biome format --write .",
    "check": "biome check --write . && tsc -b --noEmit",
    "ci": "npm run verify",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify-fast.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "bench:run": "vitest bench --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --grep-invert @netgame",
    "e2e:fast": "playwright test e2e/cross-env.spec.ts e2e/drive.spec.ts e2e/manual-control.spec.ts e2e/hud.spec.ts e2e/experiments.spec.ts e2e/collision.spec.ts e2e/shredder.spec.ts --project=chromium --grep-invert @scenario-slow",
    "e2e:experiments:fast": "playwright test e2e/experiments.spec.ts --project=chromium --grep-invert @scenario-slow",
    "e2e:experiments:slow": "playwright test e2e/experiments.spec.ts --project=chromium --grep @scenario-slow",
    "e2e:smoke": "playwright test e2e/cross-env.spec.ts",
    "e2e:net": "playwright test e2e/netgame.spec.ts e2e/netgame-stress.spec.ts e2e/netgame-damage.spec.ts --project=chromium",
    "e2e:perf": "playwright test e2e/performance.spec.ts --project=chromium",
    "eslint": "eslint .",
    "agent:check": "node scripts/check-agent-infra.mjs",
    "postinstall": "node scripts/patch-third-party.mjs",
    "prepare": "husky",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "model:build": "node scripts/convert-1trex-model.mjs",
    "video:record": "node scripts/record-scenarios-video.mjs",
    "scenario:analyze": "node scripts/analyze-scenario-log.mjs",
    "scenario:export": "node scripts/export-scenario-traces.mjs",
    "scenario:export:check": "node scripts/check-scenario-export.mjs",
    "scenario:verify": "node scripts/verify-scenario-log.mjs",
    "scenario:verify:experiments": "node scripts/verify-experiment-logs.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/rapier": "^2.2.0",
    "firebase": "^12.14.0",
    "mistreevous": "^4.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.182.0",
    "troika-three-text": "^0.52.4",
    "uplot": "^1.6.32",
    "valtio": "^2.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.4.16",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "meshoptimizer": "^1.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
