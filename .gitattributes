# Normalize line endings. Repo stores LF; checkouts use LF on every platform.
* text=auto eol=lf

# Explicit text formats — keep LF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.svg       text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf

# Windows-only scripts keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never touch line endings, never diff inline
*.glb       binary
*.gltf      binary
*.bin       binary
*.fbx       binary
*.obj       binary
*.stl       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.mp4       binary
*.webm      binary
*.mp3       binary
*.wav       binary
*.pdf       binary
*.wasm      binary
*.zip       binary
*.7z        binary

# Lockfile is text but should not show in diffs by default
package-lock.json -diff

# GitHub linguist hints — exclude tooling/lockfiles from language stats
package-lock.json   linguist-generated=true
dist/**             linguist-generated=true
docs/experiments/** linguist-documentation=true
