# Local tooling. Клиентские VITE_* нужны ТОЛЬКО для кросс-девайс мультиплеера
# через Firebase. Без них сетевой режим использует in-memory адаптер
# (мультиплеер в нескольких вкладках одного браузера) — приложение работает.

# Сетевой транспорт: memory | firebase. По умолчанию авто (firebase при наличии
# конфигурации ниже, иначе memory).
VITE_NET_ADAPTER=

# Публичный web-config Firebase (НЕ секреты — безопасность в database.rules.json
# + Anonymous Auth). Скопировать из Firebase Console → Project settings → Web app.
# Обязательны для firebase-адаптера: API_KEY, DATABASE_URL, PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Playwright/Vite port used by e2e tests.
SIM_E2E_PORT=5174

# Existing simulator URL for trace/video export scripts.
# Leave empty to let scripts start/use local Vite.
SIM_URL=

# Optional Playwright browser channel for video/trace export.
# Example: chrome
PLAYWRIGHT_CHANNEL=
