# Local tooling. Кросс-девайс мультиплеер работает ИЗ КОРОБКИ: дефолтный
# публичный Firebase-config проекта rex-1t зашит в src/netgame/net/firebaseConfig.ts.
# Переменные ниже нужны ТОЛЬКО чтобы увести приложение на СВОЙ Firebase-проект
# (форк) или принудительно отключить сеть.

# Сетевой транспорт: memory | firebase. Пусто = авто (firebase, т.к. дефолтный
# config всегда есть). memory = принудительно in-memory (несколько вкладок;
# так гоняются e2e и офлайн-разработка).
VITE_NET_ADAPTER=

# Публичный web-config Firebase ДЛЯ ФОРКА на свой проект (НЕ секреты —
# безопасность в database.rules.json + Anonymous Auth). Скопировать из Firebase
# Console → Project settings → Web app. Override срабатывает, только если заданы
# все три якоря: API_KEY, DATABASE_URL, PROJECT_ID. Иначе используется дефолт rex-1t.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Playwright/Vite port used by e2e tests.
SIM_E2E_PORT=5174

# Existing simulator URL for trace/video export scripts.
# Leave empty to let scripts start/use local Vite.
SIM_URL=

# Optional Playwright browser channel for video/trace export.
# Example: chrome
PLAYWRIGHT_CHANNEL=
